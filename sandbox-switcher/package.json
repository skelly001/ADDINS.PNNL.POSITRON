{
  "name": "sandbox-switcher",
  "displayName": "Sandbox Switcher",
  "description": "Quickly switch between R script and data sandboxes in Positron",
  "version": "0.2.0",
  "publisher": "pnnl",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sandbox.switchWdOpposite",
        "title": "Sandbox: Switch Working Directory to Opposite Sandbox"
      },
      {
        "command": "sandbox.revealPairedFolder",
        "title": "Sandbox: Reveal Paired Folder"
      },
      {
        "command": "sandbox.syncNow",
        "title": "Sandbox: Sync Directories Now"
      },
      {
        "command": "sandbox.setupWorkspaceFolders",
        "title": "Sandbox: Setup Paired Workspace Folders"
      }
    ],
    "keybindings": [
      {
        "command": "sandbox.switchWdOpposite",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "linux": "ctrl+alt+w"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sandbox.revealPairedFolder",
          "when": "sandbox.active",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test out/test/"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  },
  "license": "MIT"
}
