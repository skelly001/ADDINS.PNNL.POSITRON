# Sandbox sync startup
#
# Add this block to the .Rprofile in your HOME directory (run
# path.expand("~/.Rprofile") in R to see where that is). It contains no paths:
# the sandbox paths are recorded only in the .Renviron at the root of your
# r_script_sandbox folder.
#
# When an R session starts anywhere inside a folder whose name starts with
# "r_script_sandbox" (the root or any project subfolder), this block:
#   1. loads the .Renviron from the sandbox root, so SCRIPT_PATH and DATA_PATH
#      are set in the session;
#   2. runs `sandbox-sync sync-full` and prints its one-line result.
# In any other folder it does nothing.
#
# Do not keep a separate .Rprofile in the sandbox root: R runs only one
# .Rprofile (the startup folder's if there is one, otherwise this one). If a
# project subfolder needs its own .Rprofile, start it with
#   source("~/.Rprofile")

local({
  parts <- strsplit(
    normalizePath(getwd(), winslash = "/", mustWork = FALSE),
    "/",
    fixed = TRUE
  )[[1]]
  hit <- which(startsWith(parts, "r_script_sandbox"))
  if (length(hit) == 0) {
    return(invisible(NULL))
  }
  root <- paste(parts[seq_len(hit[1])], collapse = "/")

  renviron <- file.path(root, ".Renviron")
  if (!file.exists(renviron)) {
    message("sandbox-sync: no .Renviron in ", root, "; sync skipped")
    return(invisible(NULL))
  }
  # The root .Renviron is the only record of the paths: drop any values that
  # came from elsewhere (such as an old copy in ~/.Renviron) before loading it.
  Sys.unsetenv(c("SCRIPT_PATH", "DATA_PATH"))
  readRenviron(renviron)

  # SCRIPT_PATH is optional in .Renviron: it is the sandbox root itself.
  if (!nzchar(Sys.getenv("SCRIPT_PATH"))) {
    Sys.setenv(SCRIPT_PATH = root)
  }
  if (!nzchar(Sys.getenv("DATA_PATH"))) {
    message("sandbox-sync: DATA_PATH is not defined in ", renviron, "; sync skipped")
    return(invisible(NULL))
  }

  binary <- Sys.which("sandbox-sync")
  if (!nzchar(binary)) {
    message("sandbox-sync: binary not found on PATH; sync skipped")
    return(invisible(NULL))
  }

  output <- tryCatch(
    suppressWarnings(system2(
      binary,
      c(
        "sync-full",
        "--scripts", shQuote(Sys.getenv("SCRIPT_PATH")),
        "--data", shQuote(Sys.getenv("DATA_PATH"))
      ),
      stdout = TRUE,
      stderr = TRUE
    )),
    error = function(e) conditionMessage(e)
  )
  message("sandbox-sync: ", paste(output, collapse = "\n"))
  invisible(NULL)
})
